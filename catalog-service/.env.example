# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

PORT=3002

# PostgreSQL (base de datos propia de Catalog-Service, database-per-service)
DATABASE_URL="postgresql://catalog_user:catalog_pass@localhost:5432/catalog_db?schema=public"

# Redis (cache de consultas frecuentes)
REDIS_URL="redis://localhost:6379"

# RabbitMQ (consumo de media.ready / media.processing.failed)
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# CORS - orígenes permitidos del frontend (separados por coma)
CORS_ORIGINS="http://localhost:3000"

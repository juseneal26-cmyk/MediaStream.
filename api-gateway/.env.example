# Copiar como .env y ajustar si es necesario. Nunca commitees el .env real.
# 3000 queda libre a propósito: del 3001 al 3006 ya los usan los microservicios.
PORT=3000
NODE_ENV=development

# MISMO secreto que usa User-Service para firmar el AccessToken (sección 5 y 10
# del documento): el Gateway valida la firma sin tener que preguntarle a User.
JWT_ACCESS_SECRET="dev-access-secret"

# Orígenes permitidos del frontend (separados por coma). En desarrollo, el
# servidor de Vite. En producción, el dominio del frontend desplegado.
CORS_ORIGINS="http://localhost:5173"

# Direcciones internas de cada microservicio. En docker-compose se resuelven
# por nombre de contenedor; en Render, por la URL pública de cada servicio.
USER_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
PLAYBACK_SERVICE_URL="http://localhost:3003"
MEDIA_SERVICE_URL="http://localhost:3004"
RECOMMENDATION_SERVICE_URL="http://localhost:3005"
BILLING_SERVICE_URL="http://localhost:3006"

# Rate limiting (sección 5): más estricto en login/cobros, más permisivo en
# catálogo. Ventana en milisegundos.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_DEFAULT=120
RATE_LIMIT_MAX_SENSITIVE=10
